generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  MENTOR
  ADMIN
  INNOVATION_LEAD
  ORGANIZATION
  ORGANIZATION_ADMIN
  ORGANIZATION_REVIEWER
  SUPER_ADMIN
  STUDENT
}

enum ProjectStatus {
  IDEA
  DISCOVERING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TeamRole {
  OWNER
  MEMBER
  MENTOR
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  BLOCKED
  DONE
}

enum NotificationType {
  INVITE
  DEADLINE
  MESSAGE
  TASK_UPDATE
  AI_SUGGESTION
  SYSTEM
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
}

enum MessageScope {
  DIRECT
  GROUP
  PROJECT
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ActivityType {
  PROJECT_CREATED
  TEAM_JOINED
  TASK_UPDATED
  MESSAGE_SENT
  AI_RECOMMENDATION
}

enum LearningStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum Visibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String
  avatarUrl         String?
  bio               String?
  role              UserRole           @default(USER)
  timezone          String?
  availabilityHrs   Int?
  location          String?
  links             Json?
  emailVerifiedAt   DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  ownedProjects     Project[]          @relation("ProjectOwner")
  teamMemberships   TeamMember[]
  projectMembers    ProjectMember[]
  messages          Message[]
  notifications     Notification[]
  applications      Application[]
  learningEntries   LearningEntry[]
  achievements      Achievement[]
  activityLogs      ActivityLog[]      @relation("ActivityActor")
  aiRecommendations AIRecommendation[]
  assignedTasks     Task[]
  taskComments      TaskComment[]
  projectFiles      ProjectFile[]

  organizationMembers OrganizationMember[]

  sentConnections     Connection[] @relation("ConnectionRequester")
  receivedConnections Connection[] @relation("ConnectionReceiver")
  receivedMessages    Message[]    @relation("MessageReceiver")
}

model Project {
  id               String            @id @default(cuid())
  ownerId          String
  teamId           String?           @unique
  title            String
  slug             String            @unique
  summary          String
  problemStatement String?
  objectives       String[]
  category         String
  difficulty       String
  status           ProjectStatus     @default(IDEA)
  visibility       Visibility        @default(PUBLIC)
  remoteOnly       Boolean           @default(true)
  hybridFriendly   Boolean           @default(false)
  techStack        String[]
  coverImageUrl    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  owner            User              @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  team             Team?
  members          ProjectMember[]
  tasks            Task[]
  milestones       Milestone[]
  files            ProjectFile[]
  messages         Message[]
  applications     Application[]
  analytics        ProjectAnalytics?
  activityLogs     ActivityLog[]

  organizationId String?
  organization   Organization? @relation("OrganizationProjects", fields: [organizationId], references: [id])

  aiRecommendations AIRecommendation[]
}

model Team {
  id          String       @id @default(cuid())
  projectId   String       @unique
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members     TeamMember[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      TeamRole @default(MEMBER)
  joinedAt  DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Task {
  id          String        @id @default(cuid())
  projectId   String
  assigneeId  String?
  title       String
  description String?
  status      TaskStatus    @default(TODO)
  priority    Int           @default(3)
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?         @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    TaskComment[]
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProjectFile {
  id           String   @id @default(cuid())
  projectId    String
  uploadedById String
  name         String
  url          String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
}

model Message {
  id         String       @id @default(cuid())
  scope      MessageScope
  projectId  String?
  senderId   String
  receiverId String?
  threadId   String?
  body       String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender     User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User?        @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Application {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  status    ApplicationStatus @default(PENDING)
  message   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
}

model LearningEntry {
  id          String         @id @default(cuid())
  userId      String
  title       String
  description String?
  status      LearningStatus @default(NOT_STARTED)
  progress    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  badgeUrl    String?
  earnedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectAnalytics {
  id             String   @id @default(cuid())
  projectId      String   @unique
  completionRate Float    @default(0)
  memberCount    Int      @default(0)
  taskCount      Int      @default(0)
  milestoneCount Int      @default(0)
  lastUpdatedAt  DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String       @id @default(cuid())
  projectId String?
  actorId   String?
  type      ActivityType
  summary   String
  metadata  Json?
  createdAt DateTime     @default(now())
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actor     User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
}

model AIRecommendation {
  id        String   @id @default(cuid())
  userId    String?
  projectId String?
  title     String
  body      String
  rationale String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// NEW ORGANIZATION & VERIFICATION MODELS
// ---------------------------------------------------------------------------

model Organization {
  id                 String             @id @default(cuid())
  name               String
  type               String
  country            String
  state              String?
  city               String?
  officialEmail      String             @unique
  website            String?
  description        String?
  logo               String?
  verificationStatus VerificationStatus @default(PENDING)
  verificationLevel  String?
  verifiedAt         DateTime?
  verificationReason String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  members       OrganizationMember[]
  verifications OrganizationVerification[]
  challenges    Project[]                  @relation("OrganizationProjects")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("MEMBER")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model OrganizationVerification {
  id             String             @id @default(cuid())
  organizationId String
  repName        String
  repDesignation String
  repEmail       String
  repPhone       String?
  documentUrls   String[]
  status         VerificationStatus @default(PENDING)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
